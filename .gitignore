# StockSense AI — .gitignore

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Build outputs & caches
dist/
build/
.cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.DS_Store

# Prisma generated outputs
backend/prisma/migrations/*_migration.sql.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
