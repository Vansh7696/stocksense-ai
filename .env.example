# ==========================================
# StockSense AI — Central Environment Config
# Copy this file to .env in backend/ and ml-service/ as required
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=stocksense_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=stocksense_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stocksense_user:your_secure_password_here@localhost:5432/stocksense_db?schema=public
TEST_DATABASE_URL=postgresql://stocksense_user:your_secure_password_here@localhost:5432/stocksense_test_db?schema=public

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Backend Express API (5001 avoids macOS AirPlay collision on 5000)
PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
CSRF_SECRET=your_csrf_secret_minimum_32_characters_here
CORS_ORIGIN=http://localhost:5173

# Python ML Microservice
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
BACKEND_SERVICE_URL=http://localhost:5001

# Security & Encryption (AES-256-GCM for Upstox Tokens — 64 hex characters / 32 bytes)
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Market Data Providers (Indian Equities NSE/BSE)
# Upstox API V3 & OAuth 2.0 (Primary)
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:5001/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
UPSTOX_HISTORICAL_RATE_LIMIT=5
UPSTOX_QUOTE_RATE_LIMIT=8
UPSTOX_MINUTE_RATE_LIMIT=250
UPSTOX_30MIN_RATE_LIMIT=1000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5001/api
